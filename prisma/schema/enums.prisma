enum Role {
  SUPER_ADMIN
  AGENCY_ADMIN
  AGENCY_STAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

/// Drives the read-only gate: a TRIAL agency past trialEndsAt, or an EXPIRED /
/// SUSPENDED one, may still GET but is blocked from any write.
enum AgencyStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

/// What a plan unlocks. Checked by checkFeatureAccess(); every feature is
/// unlocked while an agency is still inside its trial window.
enum PlanFeature {
  TICKETING
  VISA
  HAJJ_UMRAH
  EXPENSE
  REPORTS
  CRM
}

/// One-way state machine, enforced in the service layer:
/// ISSUED -> REISSUED | REFUNDED | VOID ; REISSUED -> REFUNDED | VOID.
/// REFUNDED and VOID are final.
enum TicketStatus {
  ISSUED
  REISSUED
  REFUNDED
  VOID
}

/// One-way: SUBMITTED -> PROCESSING -> APPROVED | REJECTED ; APPROVED -> DELIVERED.
/// REJECTED and DELIVERED are final.
enum VisaStatus {
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  DELIVERED
}

enum HajjBookingStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum HajjPackageType {
  HAJJ
  UMRAH
}

enum DocumentStatus {
  PENDING
  RECEIVED
  VERIFIED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_BANKING
  CHEQUE
  OTHER
}

enum SubscriptionOrderStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum HajjTier {
  ECONOMY
  PREMIUM
  VIP
}

enum HajjMealPlan {
  NONE
  BREAKFAST
  FULL_BOARD
}

enum HajjBatchStatus {
  OPEN
  FULL
  DEPARTED
  COMPLETED
  CANCELLED
}

enum HajjHotelType {
  MAKKAH
  MADINAH
}

/// Which side of the ledger a posting sits on. Every money movement in the
/// system is exactly one AccountPosting with one of these directions.
enum PostingDirection {
  IN
  OUT
}

/// What caused a posting. Mirrors the columns of the source spreadsheet's
/// Balance Dashboard, so a per-source sum reproduces that sheet exactly.
enum PostingSource {
  OPENING
  INVESTMENT
  INVESTMENT_WITHDRAWAL
  PROFIT_WITHDRAWAL
  SUPPLIER_PAYMENT
  SALES_PAYMENT
  DATE_CHANGE_FEE
  DUE_RECEIVED
  EXPENSE
  EMPLOYEE_PAYOUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum CashAccountCategory {
  OWNER_FUNDS
  LOANS
  SALES_BUYING
  OTHERS
}

/// Owner capital moving in or out of the business.
enum CapitalFlowType {
  INVEST
  WITHDRAW
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

/// Only payouts — there is no advance or deduction type.
enum EmployeePayoutType {
  SALARY
  BONUS
}

enum AnnouncementType {
  INFO
  FEATURE
  MAINTENANCE
  WARNING
}

enum SupportCategory {
  BILLING
  TECHNICAL
  FEATURE_REQUEST
  OTHER
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PlanHistoryAction {
  ASSIGNED
  UPGRADED
  DOWNGRADED
  TRIAL_EXTENDED
}

/// Which subscription email an agency was sent. One of each per period end.
enum AgencyReminderKind {
  TRIAL_ENDING_3_DAYS
  TRIAL_ENDING_1_DAY
  SUBSCRIPTION_ENDING_7_DAYS
  SUBSCRIPTION_ENDING_1_DAY
  EXPIRED
}
