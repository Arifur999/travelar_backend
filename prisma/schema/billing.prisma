/// One row per checkout/retry attempt. Never mutated into a "new" attempt —
/// retrying always creates a fresh row, so the gateway trail stays auditable.
model SubscriptionOrder {
  id                   String                  @id @default(uuid(7))

  agencyId             String
  agency               Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  planId               String
  plan                 Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)

  /// Snapshotted from the plan's price at checkout — a later price change must
  /// not retroactively alter what was charged.
  amount               Decimal                 @db.Decimal(12, 2)

  /// Our own id, sent to SSLCommerz as tran_id. Format ORDER-<agencyId>-<ts>.
  transactionId        String                  @unique
  sslcommerzSessionKey String?
  /// Set only once the IPN's val_id has been independently confirmed against
  /// the Order Validation API — never straight from the callback payload.
  sslcommerzValId      String?

  status               SubscriptionOrderStatus @default(PENDING)
  paymentMethod        String?

  /// Gateway or bKash. A bKash order carries the three fields below and is
  /// reviewed by hand; a gateway order carries none of them.
  channel              PaymentChannel          @default(GATEWAY)

  /// The number the agency says they paid from, and the transaction id from
  /// their bKash message. Unique: a receipt can only be spent once, and
  /// pasting somebody else's is the obvious way to try.
  senderNumber         String?
  senderReference      String?                 @unique

  /// Who accepted or refused it, when, and why. An operator approving a
  /// payment is granting a paid plan, so it is not done anonymously.
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?                 @db.Text
  /// Full IPN payload + validation response, kept for dispute/debugging.
  rawGatewayResponse   Json?

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([agencyId])
  @@index([planId])
  @@index([status])
  /// The operator's queue: everything waiting to be read, oldest first.
  @@index([channel, status, createdAt])
  @@map("subscription_orders")
}

/// Manual / admin-recorded subscription payments (the super admin's
/// "Record Payment" flow), read alongside SubscriptionOrder for a unified view.
model Payment {
  id            String        @id @default(uuid(7))

  agencyId      String
  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  note          String?       @db.Text
  paidAt        DateTime      @default(now())
  recordedById  String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([agencyId])
  @@index([agencyId, createdAt])
  @@map("subscription_payments")
}

/// A subscription email that went out, so the hourly lifecycle job never sends
/// it twice. Keyed on the end date of the period it is about: a renewal moves
/// that date, and the reminders for the new period are free to go out again.
/// The row is written before the email is sent — the unique constraint is what
/// stops two API instances running the job at once from both sending.
model AgencyReminder {
  id           String             @id @default(uuid(7))

  agencyId     String
  agency       Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  kind         AgencyReminderKind
  periodEndsAt DateTime
  recipients   Int                @default(0)

  sentAt       DateTime           @default(now())

  @@unique([agencyId, kind, periodEndsAt])
  @@index([agencyId])
  @@map("agency_reminders")
}
