model Ticket {
  id            String       @id @default(uuid(7))

  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  passengerName String
  pnr           String
  airline       String
  supplier      String?
  routeFrom     String?
  routeTo       String?
  travelDate    DateTime?
  issueDate     DateTime     @default(now())

  fare          Decimal      @db.Decimal(12, 2)
  cost          Decimal      @db.Decimal(12, 2)
  /// Denormalized (fare - cost), recomputed in the service on every fare/cost
  /// write so list and report queries never have to derive it per row.
  profit        Decimal      @db.Decimal(12, 2) @default(0)

  status        TicketStatus @default(ISSUED)
  refundAmount  Decimal?     @db.Decimal(12, 2)

  createdById   String?
  createdBy     User?        @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  isDeleted     Boolean      @default(false)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  payments      TicketPayment[]
  documents     TicketDocument[]
  statusHistory TicketStatusHistory[]

  @@index([agencyId])
  @@index([agencyId, isDeleted])
  @@index([agencyId, status])
  @@index([customerId])
  @@index([pnr])
  @@index([travelDate])
  @@map("tickets")
}

/// totalPaid / dueAmount are deliberately NOT stored on Ticket — they are
/// aggregated from these rows at query time, so a deleted payment can never
/// leave a stale balance behind.
model TicketPayment {
  id         String        @id @default(uuid(7))

  agencyId   String
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(CASH)
  reference  String?
  note       String?       @db.Text
  paidAt     DateTime      @default(now())

  recordedById String?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([ticketId])
  @@index([agencyId])
  @@map("ticket_payments")
}

model TicketDocument {
  id         String   @id @default(uuid(7))

  agencyId   String
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileName   String
  fileUrl    String
  mimeType   String?
  sizeBytes  Int?

  uploadedById String?
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@index([agencyId])
  @@map("ticket_documents")
}

model TicketStatusHistory {
  id         String       @id @default(uuid(7))

  agencyId   String
  ticketId   String
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fromStatus TicketStatus?
  toStatus   TicketStatus
  note       String?      @db.Text

  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime    @default(now())

  @@index([ticketId])
  @@index([agencyId])
  @@map("ticket_status_history")
}
