/// Embassy / agent / consultancy master list a case can be routed through.
model VisaAgent {
  id        String     @id @default(uuid(7))

  agencyId  String
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name      String
  type      String?
  contact   String?
  email     String?
  address   String?    @db.Text
  note      String?    @db.Text

  isDeleted Boolean    @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  visaCases VisaCase[]

  @@index([agencyId])
  @@index([agencyId, isDeleted])
  @@index([agencyId, isDeleted, createdAt])
  @@map("visa_agents")
}

model VisaCase {
  id            String     @id @default(uuid(7))

  agencyId      String
  agency        Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  visaAgentId   String?
  visaAgent     VisaAgent? @relation(fields: [visaAgentId], references: [id], onDelete: SetNull)

  country       String
  visaType      String
  applicationNo String?
  submittedAt   DateTime?
  decidedAt     DateTime?

  serviceFee    Decimal    @db.Decimal(12, 2) @default(0)
  embassyFee    Decimal    @db.Decimal(12, 2) @default(0)

  status        VisaStatus @default(SUBMITTED)
  rejectionNote String?    @db.Text

  createdById   String?
  createdBy     User?      @relation("VisaCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  isDeleted     Boolean    @default(false)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  payments      VisaPayment[]
  documents     VisaDocument[]
  statusHistory VisaStatusHistory[]

  @@index([agencyId])
  @@index([agencyId, isDeleted])
  @@index([agencyId, status])
  @@index([customerId])
  @@index([visaAgentId])
  @@index([agencyId, isDeleted, createdAt])
  @@map("visa_cases")
}

model VisaPayment {
  id         String        @id @default(uuid(7))

  agencyId   String
  visaCaseId String
  visaCase   VisaCase      @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)

  /// Where the money landed. Null when the payment came out of the
  /// customer's own balance: that cash arrived when they paid it in, and
  /// posting it again would count the same money twice.
  cashAccountId String?
  cashAccount   CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  /// Settled from what the customer had already paid in, rather than with
  /// money arriving now. Such a payment posts to no account and does not
  /// change what the customer owes overall — see customer.service.ts.
  fromWallet    Boolean       @default(false)

  reference     String?
  note          String?       @db.Text
  paidAt        DateTime      @default(now())

  recordedById  String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([visaCaseId])
  @@index([agencyId])
  @@index([cashAccountId])
  @@map("visa_payments")
}

/// Auto-populated from the visaDocumentPresets for the case's visaType at
/// creation, all starting PENDING. Custom items can be appended.
model VisaDocument {
  id         String         @id @default(uuid(7))

  agencyId   String
  visaCaseId String
  visaCase   VisaCase       @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)

  title      String
  status     DocumentStatus @default(PENDING)
  fileUrl    String?
  note       String?        @db.Text

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([visaCaseId])
  @@index([agencyId])
  @@map("visa_documents")
}

model VisaStatusHistory {
  id          String      @id @default(uuid(7))

  agencyId    String
  visaCaseId  String
  visaCase    VisaCase    @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)

  fromStatus  VisaStatus?
  toStatus    VisaStatus
  note        String?     @db.Text

  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime    @default(now())

  @@index([visaCaseId])
  @@index([agencyId])
  @@map("visa_status_history")
}
