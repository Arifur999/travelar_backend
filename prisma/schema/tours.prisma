/// A tour the agency sells: one dated trip with its own seats and price.
///
/// Hajj keeps packages and batches apart because one package genuinely runs
/// many groups, each with its own rooms. A tour is sold as the trip itself —
/// "Cox's Bazar, 3 nights, 12 March" — so the two levels would be one level
/// with extra steps. An agency repeating an itinerary monthly creates one of
/// these per departure, which is how they price and count seats anyway.
model TourPackage {
  id             String            @id @default(uuid(7))

  agencyId       String
  agency         Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name           String
  destination    String

  departureDate  DateTime?
  returnDate     DateTime?
  durationDays   Int?

  /// Null means no fixed limit. Seats sold are never stored — they are counted
  /// from non-cancelled bookings at read time, so a cancellation frees a seat
  /// immediately.
  seatCapacity   Int?

  pricePerPerson Decimal           @db.Decimal(12, 2)
  /// What the trip is expected to cost the agency per head. Kept on the
  /// package as the default a booking snapshots, so a later renegotiation
  /// never moves the profit already recorded on a sold seat.
  costPerPerson  Decimal           @db.Decimal(12, 2) @default(0)

  inclusions     String?           @db.Text
  description    String?           @db.Text

  status         TourPackageStatus @default(OPEN)

  createdById    String?
  createdBy      User?             @relation("TourPackageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  isDeleted      Boolean           @default(false)
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  bookings       TourBooking[]

  @@index([agencyId])
  @@index([agencyId, isDeleted])
  @@index([agencyId, status])
  @@index([agencyId, isDeleted, createdAt])
  @@map("tour_packages")
}

/// One customer's seats on one tour — the central record of the module.
model TourBooking {
  id             String              @id @default(uuid(7))

  agencyId       String
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)

  packageId      String
  tourPackage    TourPackage         @relation(fields: [packageId], references: [id], onDelete: Restrict)

  /// Who the booking is under. The other travellers are counted, not named:
  /// a tour is sold by the seat, and the agency already has the customer.
  leadTraveller  String
  travellers     Int                 @default(1)

  /// Totals for the whole booking, not per head, and snapshotted when it is
  /// made: a later price change on the package must never move what an
  /// existing booking owes. Defaulted from the package price times the
  /// seats, then editable, because tours are where a customer haggles.
  ///
  /// Totals rather than a per-person rate on purpose — every figure the app
  /// reports (what a customer owes, revenue, profit) is a SUM over these
  /// columns, and SQL cannot sum a product of two of them.
  sellAmount     Decimal             @db.Decimal(12, 2)
  costAmount     Decimal             @db.Decimal(12, 2) @default(0)

  status         TourBookingStatus   @default(RESERVED)
  note           String?             @db.Text

  createdById    String?

  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  payments       TourPayment[]
  statusHistory  TourStatusHistory[]

  @@index([agencyId])
  @@index([agencyId, isDeleted])
  @@index([agencyId, status])
  @@index([packageId])
  @@index([customerId])
  @@index([agencyId, isDeleted, createdAt])
  @@map("tour_bookings")
}

model TourPayment {
  id            String        @id @default(uuid(7))

  agencyId      String
  bookingId     String
  booking       TourBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)

  /// Where the money landed. Null when the payment came out of the
  /// customer's own balance: that cash arrived when they paid it in, and
  /// posting it again would count the same money twice.
  cashAccountId String?
  cashAccount   CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  /// Settled from what the customer had already paid in, rather than with
  /// money arriving now. Such a payment posts to no account and does not
  /// change what the customer owes overall — see customer.service.ts.
  fromWallet    Boolean       @default(false)

  reference     String?
  note          String?       @db.Text
  paidAt        DateTime      @default(now())

  recordedById  String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingId])
  @@index([agencyId])
  @@index([cashAccountId])
  @@map("tour_payments")
}

model TourStatusHistory {
  id          String             @id @default(uuid(7))

  agencyId    String
  bookingId   String
  booking     TourBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fromStatus  TourBookingStatus?
  toStatus    TourBookingStatus
  note        String?            @db.Text

  changedById String?
  changedAt   DateTime           @default(now())

  @@index([bookingId])
  @@index([agencyId])
  @@map("tour_status_history")
}
