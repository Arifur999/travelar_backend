# Values for docker-compose.production.yaml. Copy to .env.production (gitignored)
# and pass it with --env-file. Generate each secret separately, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---- database (the container creates it with these) ----
POSTGRES_USER=travelar
POSTGRES_PASSWORD=
POSTGRES_DB=travelar

# ---- public addresses ----
# Where browsers reach the web app, and where the API is reachable from outside
# (SSLCommerz posts payment results to the API, so in production it must be a
# public HTTPS URL). Behind a reverse proxy these are the proxy's URLs.
WEB_PUBLIC_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com

# Host ports the two containers are published on.
WEB_HOST_PORT=3000
API_HOST_PORT=5050

# ---- secrets: all different, all long and random ----
BETTER_AUTH_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- the platform operator, created on first boot ----
# Sign in and change this password immediately.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

TRIAL_DAYS=7

# ---- outgoing mail ----
# Needed for password reset emails. Without it no one can recover a forgotten
# password — including the operator. Port 465 uses TLS; 587 uses STARTTLS.
EMAIL_SENDER_SMTP_HOST=
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_USER=
EMAIL_SENDER_SMTP_PASS=
EMAIL_SENDER_SMTP_FROM=

# ---- optional ----
REDIS_URL=
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
