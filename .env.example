NODE_ENV=development
PORT=5050

# Pooled runtime connection. Inside docker-compose use the service hostname:
# postgresql://postgres:postgres@travelar-db:5432/travelar
# Host 5432 is often taken by a native Postgres install; docker-compose maps to 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/travelar
# Direct (unpooled) connection, used only by `prisma migrate deploy` on deploy.
MIGRATE_DATABASE_URL=

# Optional. Use rediss:// for TLS providers like Upstash. Every Redis call
# degrades gracefully when this is unset.
REDIS_URL=

BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5050

# ACCESS_TOKEN_SECRET must be IDENTICAL to the frontend's JWT_ACCESS_SECRET,
# or proxy.ts cannot verify tokens and every protected route bounces to /login.
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

# Trial length for a newly registered agency, in days.
TRIAL_DAYS=7

# Outgoing mail — password reset links. Leave SMTP_HOST empty locally: nothing
# is sent and the message (with its link) is printed to the API's console.
EMAIL_SENDER_SMTP_HOST=
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_USER=
EMAIL_SENDER_SMTP_PASS=
EMAIL_SENDER_SMTP_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SSLCommerz (sandbox by default; set SSLCOMMERZ_IS_LIVE=true for production)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@travelar.com
SUPER_ADMIN_PASSWORD=Admin@12345

# debug | info | warn | error | silent. Default: info in production, debug here.
LOG_LEVEL=

# Shared secret for POST /api/v1/internal/jobs/* (header x-cron-secret), for an
# external scheduler. Empty disables those endpoints (they answer 404).
CRON_SECRET=
# The hourly subscription lifecycle job runs inside the API unless "false".
JOBS_ENABLED=true
# Optional error monitoring; every function no-ops when unset.
SENTRY_DSN=
