# /opt/travelar/.env — read by docker compose and by the deploy scripts.
#
# bootstrap.sh writes this file with every secret already generated. What is
# left for you: the mail and payment settings. `chmod 600` stays on it.

# The public hostname. nginx, the certificate and every URL the apps build
# (payment callbacks, reset-password links) come from this one value.
DOMAIN=travance.softech.agency

# What the release agent pulls. Pin a commit to roll back:
#   API_IMAGE=ghcr.io/arifur999/travelar-api:<sha>
API_IMAGE=ghcr.io/arifur999/travelar-api:latest
WEB_IMAGE=ghcr.io/arifur999/travelar-web:latest

# --- generated by bootstrap.sh -------------------------------------------
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Also handed to the web container as JWT_ACCESS_SECRET.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# The platform operator, created on the API's first boot only — changing these
# later does not change the account. Sign in with them at https://DOMAIN/login.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- fill these in --------------------------------------------------------
# Password-reset and subscription emails. Empty = nothing is sent, and the
# message is only written to `docker logs travelar-api`.
EMAIL_SENDER_SMTP_HOST=
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_USER=
EMAIL_SENDER_SMTP_PASS=
EMAIL_SENDER_SMTP_FROM=

# Subscription billing. Sandbox until SSLCOMMERZ_IS_LIVE=true.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- optional -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
TRIAL_DAYS=7
LOG_LEVEL=info
# 21:00 UTC = 03:00 Dhaka.
BACKUP_SCHEDULE="0 21 * * *"
BACKUP_RETENTION_DAYS=14
